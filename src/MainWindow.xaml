<Window x:Class="FiveMCacheCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FiveM Cache Cleaner" Width="780" Height="880" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0B0D12" Foreground="#F3F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Palette -->
        <Color x:Key="AccentA">#FF7A2F</Color>
        <Color x:Key="AccentB">#F43F5E</Color>
        <SolidColorBrush x:Key="Card" Color="#141821"/>
        <SolidColorBrush x:Key="CardHover" Color="#1A1F2B"/>
        <SolidColorBrush x:Key="Stroke" Color="#232938"/>
        <SolidColorBrush x:Key="Muted" Color="#8B93A7"/>
        <SolidColorBrush x:Key="AccentSolid" Color="#FF7A2F"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource AccentA}" Offset="0"/>
            <GradientStop Color="{StaticResource AccentB}" Offset="1"/>
        </LinearGradientBrush>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource AccentGradient}" CornerRadius="12"
                                Padding="32,13" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#F43F5E" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Margin="0,1,10,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A1F2B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="42" Height="24" CornerRadius="12"
                                Background="#2A3042" BorderBrush="#343B50" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="16" Height="16" Fill="#9AA3B8"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar sottile -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#2F364A" CornerRadius="4" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentGradient}">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="FiveM Cache Cleaner" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Libera spazio e riduci i crash in un clic" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </StackPanel>

        <!-- Hero -->
        <Border Grid.Row="1" Margin="0,22,0,18" Padding="24,20" CornerRadius="16"
                Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="HeroLabel" Text="SPAZIO RECUPERABILE" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Muted}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="HeroValue" Text="0 MB" FontSize="44" FontWeight="Bold"
                               Foreground="{StaticResource AccentSolid}" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="HeroSub" Text="" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Bottom" Margin="14,0,0,9"/>
                </StackPanel>

                <ProgressBar x:Name="Progress" Grid.Row="1" Height="4" VerticalAlignment="Bottom"
                             Background="Transparent" Foreground="{StaticResource AccentGradient}"
                             BorderThickness="0" Margin="0,0,0,-12"/>

                <Grid Grid.Row="2" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#0F1219" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="10" Padding="12,0">
                        <Grid>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="PathBox" Margin="26,0,0,0" Padding="0,10" Background="Transparent"
                                     Foreground="#F3F4F6" CaretBrush="White" BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="PathBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="Sfoglia…" Margin="10,0,0,0" Padding="18,10"
                            Style="{StaticResource GhostButton}" Click="Browse_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Lista -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <ItemsControl x:Name="List">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Muted}" Margin="4,10,0,8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,8"
                                Cursor="Hand" MouseLeftButtonUp="Row_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="#1E2433">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{StaticResource AccentSolid}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#1E2433" CornerRadius="8" Padding="10,4"
                                        VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Info}" FontSize="12" Foreground="#C9CEDB"/>
                                </Border>
                                <CheckBox Grid.Column="3" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Azioni -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="LogToggle" Content="Mostra dettagli" Padding="14,10" HorizontalAlignment="Left"
                    Style="{StaticResource GhostButton}" Foreground="{StaticResource Muted}" Click="LogToggle_Click"/>
            <Button x:Name="ScanBtn" Grid.Column="1" Content="Analizza" Margin="0,0,10,0" Padding="22,12"
                    Style="{StaticResource GhostButton}" Click="Scan_Click"/>
            <Button x:Name="CleanBtn" Grid.Column="2" Content="Pulisci ora"
                    Style="{StaticResource PrimaryButton}" Click="Clean_Click"/>
        </Grid>

        <!-- Log -->
        <TextBox x:Name="Log" Grid.Row="4" Visibility="Collapsed" Height="120" Margin="0,12,0,0"
                 IsReadOnly="True" Background="#0F1219" Foreground="{StaticResource Muted}"
                 BorderBrush="{StaticResource Stroke}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 Padding="10" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
    </Grid>
</Window>
